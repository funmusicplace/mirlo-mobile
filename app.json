{
  "expo": {
    "name": "Mirlo",
    "slug": "mirlo-mobile",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mirlo",
    "userInterfaceStyle": "automatic",
    "jsEngine": "hermes",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "space.mirlo.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "audio"
        ]
      },
      "icon": {
        "dark": "./assets/images/mirlo-logo-logoOnly-dark.png",
        "light": "./assets/images/mirlo-app-icon-light.png"
      },
      "runtimeVersion": "1.0.2",
      "associatedDomains": [
        "applinks:mirlo.space"
      ],
      "appleTeamId": "VZCHHV7VNW"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/Logo-Mirlo_LogoOnly.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "package": "space.mirlo.mobile",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "mirlo.space",
              "path": "/"
            },
            {
              "scheme": "https",
              "host": "mirlo.space",
              "pathAdvancedPattern": "/[^/]+"
            },
            {
              "scheme": "https",
              "host": "mirlo.space",
              "pathAdvancedPattern": "/[^/]+/release/[^/]+"
            },
            {
              "scheme": "https",
              "host": "mirlo.space",
              "pathAdvancedPattern": "/[^/]+/release/[^/]+/tracks/[0-9]+"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/Logo-Mirlo_LogoOnly.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Allow Mirlo-Mobile to access your Face ID biometric data."
        }
      ],
      "expo-localization",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "a2ccd2d1-a537-4697-9df3-43228ba534ef"
      }
    },
    "owner": "mirlo-app",
    "runtimeVersion": "1.0.2",
    "updates": {
      "url": "https://u.expo.dev/a2ccd2d1-a537-4697-9df3-43228ba534ef",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 2000
    }
  }
}
