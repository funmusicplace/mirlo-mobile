{
  "cli": {
    "version": ">= 15.0.10",
    "appVersionSource": "remote",
    "promptToConfigurePushNotifications": false
  },
  "build": {
    "development-simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "channel": "development-simulator",
      "env": {
        "APP_VARIANT": "development"
      }
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "APP_VARIANT": "development"
      }
    },
    "development-testflight": {
      "extends": "development",
      "distribution": "store",
      "autoIncrement": true
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview"
    },
    "staging": {
      "channel": "staging"
    },
    "production": {
      "autoIncrement": true,
      "channel": "production"
    },
    "production-simulator": {
      "extends": "production",
      "ios": {
        "simulator": true
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6772334902",
        "ascApiKeyPath": "./asc-api-key.p8",
        "ascApiKeyId": "TFRK82UNV2",
        "ascApiKeyIssuerId": "69a6de81-d9e1-47e3-e053-5b8c7c11a4d1"
      },
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json",
        "track": "internal"
      }
    },
    "development-testflight": {}
  }
}
